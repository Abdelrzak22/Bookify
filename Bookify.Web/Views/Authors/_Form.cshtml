@model AuthorFormViemModel

<form method="post"
      asp-action="@(Model?.Id > 0 ? "Edit" : "Create")"
      data-ajax="true"
      data-ajax-method="post"
      data-ajax-begin="onModalBegin"
      data-ajax-success="onModalSuccess"
      data-ajax-failure="showErrorMessage"
      data-ajax-complete="onModalComplete">

    @Html.AntiForgeryToken()

    @if (Model?.Id > 0)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="mb-5">
        <div class="form-floating mb-2">
            <input asp-for="Name"
                   class="form-control"
                   placeholder="Name" />
            <label asp-for="Name"></label>
        </div>

        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <partial name="_ModalFooter" />
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}